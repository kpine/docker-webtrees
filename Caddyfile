{
	supervisor {
		/bin/php-fpm --fpm-config /etc/php-fpm.conf
	}
}

:2015

root * /srv/webtrees
php_fastcgi unix//run/php-fpm.sock
encode gzip

@static {
	path /public/*
	path /favicon.ico
	path /apple-touch-icon.png
}
file_server @static

@forbidden {
	path /app/*
	path /data/*
	path /modules_v4/*
	path /resources/*
	path /vendor/*
}
rewrite @forbidden /index.php
